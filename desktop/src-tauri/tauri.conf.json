{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "知舟 Deep Tutor",
  "version": "1.0.0",
  "identifier": "com.deeptutor.workspace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "知舟 Deep Tutor · 个人学习操作系统",
        "width": 1440,
        "height": 900,
        "minWidth": 375,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "知舟 Deep Tutor"
      }
    }
  }
}
