# Deep-tutor 配置示例。复制为 .env 并填写。.env 不入库（见 .gitignore）。
# 字段说明见 plan/09-audit.md §十七 配置项目录。

# --- LLM / Anthropic ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5

# --- 认证（本地单用户）---
AUTH_TOKEN=change-me-please

# --- 存储 ---
DB_PATH=data/deep-tutor.db
DATA_DIR=data
SKILLS_DIR=skills

# --- 限额 ---
MAX_UPLOAD_MB=50
MAX_TOOL_CALLS=20
MAX_REGENERATIONS=2
CONTEXT_TOKEN_THRESHOLD=0

# --- 预算（成本控制，USD）---
BUDGET_PER_SESSION_USD=1.0
DAILY_BUDGET_USD=10

# --- 搜索 ---
SEARCH_ENGINE=bing
BING_API_KEY=

# --- 杂项 ---
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
