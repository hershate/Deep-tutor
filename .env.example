# Deep-tutor 配置示例。复制为 .env 并填写。.env 不入库（见 .gitignore）。
# 字段说明见 docs/archive/plan-v1/09-audit.md §十七 配置项目录。
#
# 全部可选（iter 89 零配置开箱即用）：没有任何 .env 也能启动——后端以
# 「开放本机模式」运行（免登录，局域网可访问），首次打开浏览器进入设置向导，
# 访问密码与 AI API Key 均可在界面内配置。下方字段用于多用户/固定密钥等高级场景。

# --- LLM / Anthropic ---
# 留空即可：生成功能暂不可用，首次打开浏览器可在设置向导/设置页界面内配置
# （设置页「API Key 档案」可建多个 Key 卡片快速切换，启用中的档案优先于此 .env 值；
#  切勿填占位值——模板占位值会被后端视为未配置，见 settings.py 模块头注释）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- 认证（P4 多用户）---
# AUTH_TOKEN：简单 token 回退（与 JWT 双轨；本地单用户部署可仅配此项，无需登录页）。
# 始终有效作回退——设置页「访问令牌」档案（PAT，可多张并存、按用户归属认证）停用/误删时
# 仍可用此 token 登录防锁死。留空即可：未设任何密码时后端以开放本机模式免登录运行，密码可在界面内设置
AUTH_TOKEN=
# 管理员账号（启动时自动创建/收敛；不设置 ADMIN_PASSWORD 则 JWT 登录不可用，仅 AUTH_TOKEN 回退）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# JWT 签名密钥（留空 -> 自动生成随机密钥并持久化到 data/.jwt_secret，重启不失效；
# 多实例部署需显式设置同一密钥）
JWT_SECRET=
JWT_EXPIRE_DAYS=7

# --- 存储 ---
DB_PATH=data/deep-tutor.db
# 完整 SQLAlchemy 数据库 URL（切换 PostgreSQL 等时用；设置后优先于 DB_PATH，空 -> SQLite）
DATABASE_URL=
DATA_DIR=data
SKILLS_DIR=skills
# 后端插件目录（目录自动发现装载，开发规范见 API.md「后端插件 API」）
PLUGINS_DIR=plugins
# 前端构建产物目录：设置后由后端托管 SPA（免 nginx，scripts/start.* 自动注入；留空=仅 API）
FRONTEND_DIST=

# --- 限额 ---
MAX_UPLOAD_MB=50
MAX_TOOL_CALLS=20
MAX_REGENERATIONS=2
# LLM 单次输出 token 上限（防大输出如长题集被截断；iter 355，默认 100000）。
# 所用模型实际输出上限更低时会触发 400——在设置页「界面偏好」可按用户调低。仅用于生成类工具
LLM_MAX_TOKENS=100000

# --- 并发与数据库连接（多用户 / 高负载，iter 366）---
# 单进程 SQLite 下，每个 SSE 长连接经 get_db 钉住一条连接直至流结束；默认连接池在
# 约 15 条并发 SSE 即耗尽。下列参数按并发用户数上调。切换 PostgreSQL 时连接池同样适用。
DB_BUSY_TIMEOUT_MS=10000      # SQLite 写-写争用等待上限（毫秒），超此报 database is locked
DB_POOL_SIZE=20               # 连接池常驻大小
DB_MAX_OVERFLOW=80            # 连接池溢出上限（pool_size + max_overflow = 总连接上限）
DB_POOL_TIMEOUT=30            # 取连接等待上限（秒）
# 任务级并发配额（原硬编 全局 2/每用户 1，100 用户场景下 98% 被直接 503）。
# 提为可配：部署方按数据库后端与 LLM 速率限额调整；真实 LLM 并发由下一项全局信号量兜底
MAX_CONCURRENT_GENERATIONS=8           # 全局同时方案生成任务数（超额 503 server_busy）
MAX_CONCURRENT_GENERATIONS_PER_USER=1  # 单用户同时方案生成任务数
MAX_CONCURRENT_CHAT_RUNS=8             # 全局同时 AI 对话 run 数（超额 503 chat_run_busy）
MAX_RUNNING_CHAT_PER_THREAD=1          # 单会话同时 AI 对话 run 数
# 全局并发 LLM 调用上限（生成/对话/材料/后台测验共享的背压信号量）。
# 超额任务排队等待而非无上限并发——防止触发模型供应商速率限制风暴与内存膨胀。0=不限
MAX_CONCURRENT_LLM_CALLS=16
# 插件事件监听器后台线程数上限（超额丢弃事件，防线程无界膨胀 OOM）
MAX_PLUGIN_EVENT_THREADS=32
# 插件 Webhook 并发投递上限（超额排队，防打满出站连接/文件描述符）。0=不限
MAX_CONCURRENT_WEBHOOK_DELIVERIES=16
# 搜索引擎页面抓取并发上限（跨方案生成共享，防触发反爬验证码）。0=不限
MAX_CONCURRENT_SEARCH_FETCHES=2
# 方案生成旁挂 Run 模型（run(kind=plan_generation) 进统一 Run 视图；默认关闭）
AGENT_RUNS_ENABLED=false

# --- 预算（成本控制；额度按 CNY 计价——*_usd 为历史字段名，UI 全链展示为￥）---
BUDGET_PER_SESSION_USD=1.0
DAILY_BUDGET_USD=10

# --- 搜索 ---
# auto=有 BING_API_KEY 用付费 API（质量更高），无 key 用免 Key 网页版（默认）
# bing=仅用付费 API（无 key 时资源检索降级为关键词建议，不再静默回退网页版）；
# bing_web=仅用免 Key 网页版。设置页「Bing 搜索 Key」档案启用后优先于此 .env 值；全部停用回退此值
SEARCH_ENGINE=auto
BING_API_KEY=

# --- 多模态（P3；依赖缺失时对应入口禁用 + 提示安装，不影响其余功能）---
# 图片 OCR：需系统安装 tesseract-ocr 二进制 + pip install pytesseract Pillow
OCR_LANGUAGES=eng+chi_sim
# 音视频转写：pip install faster-whisper（首次使用自动下载模型）
WHISPER_MODEL=base
MEDIA_MAX_MINUTES=30

# --- 杂项 ---
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

# --- 前端构建期变量（frontend/.env*，vite 注入 import.meta.env；与后端 .env 分文件）---
# VITE_API_PROXY_TARGET=http://localhost:8000   # dev 代理目标（npm run dev；默认 8000）
