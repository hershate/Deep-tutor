# Deep-tutor 配置示例。复制为 .env 并填写。.env 不入库（见 .gitignore）。
# 字段说明见 plan/09-audit.md §十七 配置项目录。
#
# 全部可选（iter 89 零配置开箱即用）：没有任何 .env 也能启动——后端以
# 「开放本机模式」运行（免登录，局域网可访问），首次打开浏览器进入设置向导，
# 访问密码与 AI API Key 均可在界面内配置。下方字段用于多用户/固定密钥等高级场景。

# --- LLM / Anthropic ---
# 留空即可：生成功能暂不可用，首次打开浏览器可在设置向导/设置页界面内配置
# （设置页「API Key 档案」可建多个 Key 卡片快速切换，启用中的档案优先于此 .env 值；
#  切勿填占位值——模板占位值会被后端视为未配置，见 settings.py 模块头注释）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- 认证（P4 多用户）---
# AUTH_TOKEN：简单 token 回退（与 JWT 双轨；本地单用户部署可仅配此项，无需登录页）。
# 始终有效作回退——设置页「访问令牌」档案（PAT，可多张并存、按用户归属认证）停用/误删时
# 仍可用此 token 登录防锁死。留空即可：未设任何密码时后端以开放本机模式免登录运行，密码可在界面内设置
AUTH_TOKEN=
# 管理员账号（启动时自动创建/收敛；不设置 ADMIN_PASSWORD 则 JWT 登录不可用，仅 AUTH_TOKEN 回退）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# JWT 签名密钥（留空 -> 回退 AUTH_TOKEN；再无 -> 进程级随机，重启后已签发 token 失效）
JWT_SECRET=
JWT_EXPIRE_DAYS=7

# --- 存储 ---
DB_PATH=data/deep-tutor.db
DATA_DIR=data
SKILLS_DIR=skills
# 后端插件目录（目录自动发现装载，开发规范见 API.md「后端插件 API」）
PLUGINS_DIR=plugins
# 前端构建产物目录：设置后由后端托管 SPA（免 nginx，scripts/start.* 自动注入；留空=仅 API）
FRONTEND_DIST=

# --- 限额 ---
MAX_UPLOAD_MB=50
MAX_TOOL_CALLS=20
MAX_REGENERATIONS=2
CONTEXT_TOKEN_THRESHOLD=0

# --- 预算（成本控制，USD）---
BUDGET_PER_SESSION_USD=1.0
DAILY_BUDGET_USD=10

# --- 搜索 ---
# auto=有 BING_API_KEY 用付费 API（质量更高），无 key 用免 Key 网页版（默认）
# bing=仅用付费 API（无 key 时资源检索降级为关键词建议）；bing_web=仅用免 Key 网页版
# 设置页「Bing 搜索 Key」档案启用后优先于此 .env 值；全部停用回退此值
SEARCH_ENGINE=auto
BING_API_KEY=

# --- 多模态（P3；依赖缺失时对应入口禁用 + 提示安装，不影响其余功能）---
# 图片 OCR：需系统安装 tesseract-ocr 二进制 + pip install pytesseract Pillow
OCR_LANGUAGES=eng+chi_sim
# 音视频转写：pip install faster-whisper（首次使用自动下载模型）
WHISPER_MODEL=base
MEDIA_MAX_MINUTES=30

# --- 杂项 ---
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
