# Auto detect text files and perform LF normalization
* text=auto

# Line-ending rules for source types present in the tracked tree
.gitattributes text eol=lf
.gitignore text eol=lf
.githooks/** text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.txt text eol=lf
*.yml text eol=lf
